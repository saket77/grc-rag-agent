# Copy to .env locally, then enter the provided key in your editor.
# Never commit .env. Environment variables override this file.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Answer generation is always gpt-4o-mini.
MAX_DOCUMENT_BYTES=10485760
MAX_QUESTIONS_BYTES=131072
MAX_REQUEST_BYTES=11534336
MAX_QUESTIONS=50
MAX_QUESTION_CHARS=2000
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARS=1000000
MAX_CHUNKS=2000
MAX_JSON_DEPTH=64
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=6
EMBEDDING_BATCH_SIZE=64
MAX_PROVIDER_CALLS=4
MAX_ACTIVE_REQUESTS=2
WORKER_THREADS=2
REQUEST_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=30
MAX_ANSWER_TOKENS=1200
